{
  "workspace": [
    "./submodules/threewebxrwebgpudeno"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "deno.unstable", "dom", "dom.iterable"]
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@gfx/dwm": "jsr:@gfx/dwm@^0.3.9",
    "@milly/namedpipe": "jsr:@milly/namedpipe@^1.1.0",
    "@mommysgoodpuppy/logchannel": "jsr:@mommysgoodpuppy/logchannel@^0.1.0",
    "@denosaurs/byte-type": "https://raw.githubusercontent.com/mommysgoodpuppy/byte_type_C/refs/heads/main/mod.ts",
    "@std/path": "jsr:@std/path@^1.1.4",
    //pmdrs
    "@pmndrs/xr": "./submodules/threewebxrwebgpudeno/submodules/xr/packages/react/xr/src/index.ts",
    "@pmndrs/handle": "./submodules/threewebxrwebgpudeno/submodules/xr/packages/handle/src/index.ts",
    "@pmndrs/pointer-events": "./submodules/threewebxrwebgpudeno/submodules/xr/packages/pointer-events/src/index.ts",
    //r3f
    "@react-three/fiber": "./classes/r3fWebgpuCompat.ts",
    "@react-three/fiber/webgpu": "./classes/r3fWebgpuCompat.ts",
    "@react-three/handle": "./submodules/threewebxrwebgpudeno/submodules/xr/packages/react/handle/src/index.ts",
    "react": "npm:react@^19.2.5",
    "@types/react": "npm:@types/react@^19.2.14",
    "react-dom": "npm:react-dom@^19.2.5",
    //three.js
    "three": "https://cdn.jsdelivr.net/gh/mrdoob/three.js@30e9dd1b8ac9b9bec8f37a30a07bbed1dc63f392/build/three.webgpu.js",
    "three/webgpu": "https://cdn.jsdelivr.net/gh/mrdoob/three.js@30e9dd1b8ac9b9bec8f37a30a07bbed1dc63f392/build/three.webgpu.js",
    "three/addons/": "https://cdn.jsdelivr.net/gh/mrdoob/three.js@30e9dd1b8ac9b9bec8f37a30a07bbed1dc63f392/examples/jsm/",
    "three/tsl": "https://cdn.jsdelivr.net/gh/mrdoob/three.js@30e9dd1b8ac9b9bec8f37a30a07bbed1dc63f392/build/three.tsl.js",
    "https://cdn.jsdelivr.net/gh/mrdoob/three.js@dev/": "https://cdn.jsdelivr.net/gh/mrdoob/three.js@30e9dd1b8ac9b9bec8f37a30a07bbed1dc63f392/",
    "@types/three": "npm:@types/three@^0.182.0",
    "@win32/km": "https://win32.deno.dev/0.4.1/UI.Input.KeyboardAndMouse"
  },
  "tasks": {
    "preconf": "deno run -A utils/preconf.ts",
    "nulldriver:true": "deno run -A utils/null-driver-toggle.ts true",
    "nulldriver:false": "deno run -A utils/null-driver-toggle.ts false",
    "openvr:probe": "deno run -A utils/openvr-timing-probe.ts",
    "audio:probe": "deno run -A utils/raylib-audio-context-probe.ts",
    "repro:raylib-reload": "deno run -A --no-check tests/raylib_worker_reload_repro/main.ts",
    "vitebuild": "cd submodules/frontend && deno task build",
    "cefbuild": "cd submodules/cefpuppy && deno run -A build.ts -ExampleName cefsimple -Profile release",
    "iwerbuild": "cd submodules/threewebxrwebgpudeno/submodules/iwer && npm run build",
    "check": "deno run -A utils/type-check.ts",
    "check:all": "deno check --allow-import",
    "ui": "deno run -A petplay/uiViewer.tsx ",
    "desktop": "deno run -A --unstable-webgpu --env-file petplay/desktopControlSurface.tsx --desktop-control-child ",
    "keyb": "deno run -A petplay/keyboardViewer.tsx ",
    "keyb:reset": "deno run -A petplay/resetKeyboard.ts",
    "build": {
      "command": "deno compile -A --env-file --no-check --include ./petplay/ --include ./classes/ --include ./resources/ --include ./submodules/threewebxrwebgpudeno/vendor/three-msdf-text-utils/demo/fonts/roboto/ --icon resources/petplay.ico petplay/petplay.ts dev"
    },
    "devw": {
      "command": "deno run -A --env-file utils/watcher.ts --watch ./petplay/ --ext ts --verbose --exec \"deno run -A petplay/petplay.ts dev\"",
      "dependencies": [
        "cefbuild"
      ]
    },
    "dev": {
      "command": "deno run -A utils/dev-runner.ts",
      "dependencies": [
        //"iwerbuild"
      ]
    },
    "dev:network": {
      "command": "deno task dev --stageforge-networking"
    },
    "dev:novr": {
      "command": "deno run -A --unstable-webgpu --env-file --no-check petplay/petplay.ts dev --novr",
      "dependencies": [
        //"iwerbuild"
      ]
    }
  },
  "unstable": [
    "net",
    "worker-options",
    "sloppy-imports"
  ],
  "fmt": {
    "semiColons": true,
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-unused-vars",
        "no-inner-declarations"
      ]
    }
  },
  "exclude": [
    "submodules/",
    "dist/",
    "submodules/threewebxrwebgpudeno/submodules/"
  ],
  "scopes": {
    "./submodules/threewebxrwebgpudeno/": {
      "iwer": "./submodules/threewebxrwebgpudeno/submodules/iwer/src/index.ts",
      "iwer/": "./submodules/threewebxrwebgpudeno/submodules/iwer/src/"
    }
  }
}
